# サイトの公開URL（OGP画像・sitemap等の生成に使用。Vercelデプロイ後のURLに差し替える）
NEXT_PUBLIC_SITE_URL=https://mrsatto.com

# Google AdSense（秘密情報ではない公開設定値。Vercelでは Config として登録する）。
# - CLIENT_ID は「ca-pub-」で始まる発行者ID。未設定の間は広告スクリプトを読み込まず、広告は一切出ない。
# - SLOT_* はAdSenseの「広告ユニット」(ディスプレイ広告)で発行される10桁前後の数字。
#   空の枠は表示されない(広告ユニットを作った枠だけ、IDを設定すると表示される)。
#   最初はツールページ内(TOOL_PAGE)とフッター(FOOTER)だけ設定する想定。
NEXT_PUBLIC_ADSENSE_CLIENT_ID=
NEXT_PUBLIC_ADSENSE_SLOT_HEADER=
NEXT_PUBLIC_ADSENSE_SLOT_TOOL_PAGE=
NEXT_PUBLIC_ADSENSE_SLOT_FOOTER=
NEXT_PUBLIC_ADSENSE_SLOT_PRE_DOWNLOAD=
NEXT_PUBLIC_ADSENSE_SLOT_POST_DOWNLOAD=

# Google Ad Manager（Google Publisher Tag）Rewarded Ads（Freeユーザーが処理済みファイルを
# ダウンロードする時に、「広告を見て1時間は広告なしで使う」ために使用）。
# GAMダッシュボードに表示される広告ユニットパスをそのまま設定する
# （例: /21775744923/mrsatto/rewarded）。秘密情報ではない。
# 未設定の間(広告の審査中など)は、「ダウンロード時に広告を見る」制限をかけず、
# Freeでもそのままダウンロードできるようにしている(プレミアム限定ツールは対象外)。
# 設定すると、自動で「ダウンロード時に広告を見る」状態になる(Standard/Premiumは広告なし)。
# 広告自体が配信されなかった場合(SDK読み込み失敗・在庫なし等)は、暫定的に1時間の
# 代替の利用権を付与する(src/lib/plans/fallback-grant-policy.ts。現在は回数制限なし)。
NEXT_PUBLIC_GAM_REWARDED_AD_UNIT_PATH=

# Supabase（会員登録・ログイン・契約状態の保存に使用。Phase 3）
# URL / anon keyはブラウザへ公開して問題ない値（Supabaseの設計上RLSが前提）。
# 未設定の場合、会員登録・ログイン機能は「準備中」表示になり、
# 既存のログイン不要ツールの動作には影響しない。
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase Service Role Key（秘密情報）。
# Stripe Webhookがsubscriptionsテーブルを更新する処理と、管理画面(/admin)が
# 全会員・全利用ログを横断的に読み取る処理の2箇所でのみ使用する。
# 絶対にNEXT_PUBLIC_を付けない・クライアントへ渡さないこと。
SUPABASE_SERVICE_ROLE_KEY=

# リワード広告視聴後のTemporary Access（1時間）トークンの署名に使う秘密鍵（秘密情報）。
# 任意の長いランダム文字列を設定する（例: `openssl rand -base64 32`）。
TEMP_ACCESS_SECRET=

# Stripe（Premiumの月額課金。旧Standardは契約中の人の判定だけに残す）
# 秘密情報。絶対にNEXT_PUBLIC_を付けない。
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# 旧Standard(550円)の価格ID。新規の申し込みには使わない。契約中の人のプラン判定だけに使う（移行が終わったら空にする）
STRIPE_STANDARD_PRICE_ID=
# 決済(Checkout)に使うPremiumの価格ID。月額1,100円(税込・JPY・毎月)であることを、決済の前に自動で照合する。
# 金額が違う（例: 旧980円のまま）場合は、課金せず「準備中」になる。
STRIPE_PREMIUM_PRICE_ID=
# 料金体系はFree / Premium(1,100円/月)に統一する方針。契約の判定（Webhook）に使う任意の設定:
#   STRIPE_PREMIUM_PRODUCT_ID       Premium専用のProduct ID。設定すると、その商品の価格はすべてPremiumとして扱う
#                                   （他の用途の商品を含まないことをStripeダッシュボードで確認してから設定する）
#   STRIPE_PREMIUM_LEGACY_PRICE_IDS 契約の移行が終わるまでだけPremiumとして扱う旧価格のID（カンマ区切り。移行後は空にする）
STRIPE_PREMIUM_PRODUCT_ID=
STRIPE_PREMIUM_LEGACY_PRICE_IDS=
# Customer Portal（解約・支払い方法の変更）のMr.Satto専用の設定ID（bpc_…）。秘密情報ではない。
# 同じStripeアカウントを他のサービスと共有している場合は、必ず設定する（未設定だと、アカウントの既定の設定が使われる）。
# 作り方: scripts/create-portal-config.mjs（ファイル先頭のコメント参照）
STRIPE_PORTAL_CONFIGURATION_ID=

# AI補助機能（年度カレンダーの予定表の読み取り補助。Premium限定）。サーバー側のみ・秘密情報。
# 未設定の間は、AI補助は「利用不可」になる。Productionにだけ設定し、Preview環境には設定しない
# （VERCEL_ENV=preview では、設定されていても利用不可にする）。
OPENAI_API_KEY=

# 管理画面(/admin)の管理者判定に使う、管理者のメールアドレス（カンマ区切りで複数可）。
# 秘密情報ではないが、NEXT_PUBLIC_は付けない（サーバー側の判定にのみ使う）。
# 例: ADMIN_EMAILS=owner@example.com,ops@example.com
# 未設定の場合、/admin は誰もアクセスできない（安全側の既定値）。
ADMIN_EMAILS=

# アクセス数（管理画面）に含めない、追加のアカウントのメールアドレス（カンマ区切り。任意）。
# ADMIN_EMAILS の管理者は、自動で除外されます。ログインしていない状態のアクセスは除外できません。
ANALYTICS_EXCLUDED_EMAILS=
