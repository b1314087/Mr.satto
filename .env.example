# サイトの公開URL（OGP画像・sitemap等の生成に使用。Vercelデプロイ後のURLに差し替える）
NEXT_PUBLIC_SITE_URL=https://example.vercel.app

# Google AdSense（未設定の場合、広告は表示されずプレースホルダーになる。秘密情報ではない）
NEXT_PUBLIC_ADSENSE_CLIENT_ID=
NEXT_PUBLIC_ADSENSE_SLOT_HEADER=
NEXT_PUBLIC_ADSENSE_SLOT_TOOL_PAGE=
NEXT_PUBLIC_ADSENSE_SLOT_FOOTER=
NEXT_PUBLIC_ADSENSE_SLOT_PRE_DOWNLOAD=
NEXT_PUBLIC_ADSENSE_SLOT_POST_DOWNLOAD=

# Google Ad Manager（Google Publisher Tag）Rewarded Ads（Phase 4：Freeユーザーの
# 「広告を見て15分無料で使う」で使用）。GAMダッシュボードに表示される
# 広告ユニットパスをそのまま設定する（例: /21775744923/mrsatto/rewarded）。
# 秘密情報ではない。未設定の場合、Rewarded Adは「利用不可」として扱われ、
# 広告を見ていないのに無条件でTemporary Accessが付与されることはない。
NEXT_PUBLIC_GAM_REWARDED_AD_UNIT_PATH=

# Supabase（会員登録・ログイン・契約状態の保存に使用。Phase 3）
# URL / anon keyはブラウザへ公開して問題ない値（Supabaseの設計上RLSが前提）。
# 未設定の場合、会員登録・ログイン機能は「準備中」表示になり、
# 既存のログイン不要ツールの動作には影響しない。
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase Service Role Key（秘密情報）。
# Stripe Webhookがsubscriptionsテーブルを更新するためだけに使用する。
# 絶対にNEXT_PUBLIC_を付けない・クライアントへ渡さないこと。
SUPABASE_SERVICE_ROLE_KEY=

# リワード広告視聴後のTemporary Access（15分）トークンの署名に使う秘密鍵（秘密情報）。
# 任意の長いランダム文字列を設定する（例: `openssl rand -base64 32`）。
TEMP_ACCESS_SECRET=

# Stripe（Standard/Premiumの月額課金。Phase 3）
# 秘密情報。絶対にNEXT_PUBLIC_を付けない。
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Stripeダッシュボードで作成した、Standard(550円/月)・Premium(980円/月)の
# 月額サブスクリプション用Price ID。
STRIPE_STANDARD_PRICE_ID=
STRIPE_PREMIUM_PRICE_ID=
